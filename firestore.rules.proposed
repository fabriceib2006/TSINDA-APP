rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // =========================================================================
    // USERS COLLECTION & SUBCOLLECTIONS
    // =========================================================================
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();

      // Student signup (role 'student', phone email match, exact keys) OR Admin profile creation
      allow create: if (isAdmin() && isOwner(userId)) || (
        isSignedIn() && 
        request.auth.uid == userId &&
        request.auth.token.email == request.resource.data.phone + '@students.tsinda.app' &&
        request.resource.data.role == 'student' &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'role', 'status', 'createdAt'])
      );

      // Profile updates: safe profile fields only for students; admin updates restricted to same safe fields
      allow update: if (isOwner(userId) || isAdmin()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'email', 'updatedAt', 'language', 'avatar']) &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.uid == resource.data.uid &&
        request.resource.data.phone == resource.data.phone &&
        request.resource.data.status == resource.data.status;

      allow delete: if isAdmin();

      // Purchases subcollection (owner read, server/admin write only)
      match /purchases/{purchaseId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Access entitlement cache (owner read, server/admin write only)
      match /access/{docId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if isAdmin();
      }

      // Progress subcollection (owner read, owner update for designated learning fields)
      match /progress/{progressId} {
        allow read: if isOwner(userId) || isAdmin();
        allow create, update: if isOwner(userId) &&
          request.resource.data.keys().hasOnly(['lessonId', 'completed', 'quizScore', 'lastAccessed', 'updatedAt', 'score', 'percent', 'answers']);
        allow delete: if isAdmin();
      }

      // Exam Attempts (Server-side management, owner read)
      match /examAttempts/{attemptId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }

      // Exam Results (Server-side management, owner read)
      match /examResults/{resultId} {
        allow read: if isOwner(userId) || isAdmin();
        allow write: if false;
      }
    }

    // =========================================================================
    // ADMINS COLLECTION
    // =========================================================================
    match /admins/{uid} {
      allow read: if isSignedIn() && request.auth.uid == uid;
      allow write: if false;
    }

    // =========================================================================
    // PLANS & PROMOTIONS
    // =========================================================================
    match /plans/{planId} {
      allow read: if (resource.data.isActive == true) || isAdmin();
      allow write: if isAdmin();
    }

    match /promotions/{promoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // SUBSCRIPTIONS & PAYMENTS
    // =========================================================================
    match /subscriptions/{subId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create, update, delete: if isAdmin();
    }

    match /payments/{paymentId} {
      allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow write: if false;
    }

    // =========================================================================
    // LESSONS & VIDEOS
    // =========================================================================
    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isAdmin();

      match /quizzes/{quizId} {
        allow read: if isSignedIn();
        allow write: if isAdmin();
      }
    }

    match /videos/{videoId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // QUESTIONS & EXAMS
    // TEMPORARY: Signed-in users can read questions for practice/mock exam in browser.
    // =========================================================================
    match /questions/{questionId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /examSettings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // =========================================================================
    // HOMEPAGE, CMS & PUBLIC STATS
    // =========================================================================
    match /siteStats/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /homepageSections/{secId} { allow read: if true; allow write: if isAdmin(); }
    match /homepageItems/{itemId} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{annId} { allow read: if true; allow write: if isAdmin(); }
    match /footerGroups/{groupId} { allow read: if true; allow write: if isAdmin(); }
    match /footerLinks/{linkId} { allow read: if true; allow write: if isAdmin(); }
    match /socialLinks/{socId} { allow read: if true; allow write: if isAdmin(); }
    match /siteMedia/{mediaId} { allow read: if true; allow write: if isAdmin(); }
    match /imageSlots/{slotId} { allow read: if true; allow write: if isAdmin(); }

    match /adminLogs/{logId} {
      allow read, write: if isAdmin();
    }

    // =========================================================================
    // DEFAULT DENY
    // =========================================================================
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
