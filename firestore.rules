rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function isAdmin() { 
      return isSignedIn() && exists(/databases/$(database)/documents/admins/$(request.auth.uid)); 
    }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }

    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if (isAdmin() && isOwner(userId)) || (
        isSignedIn() && request.auth.uid == userId &&
        (request.resource.data.role == 'student' || request.resource.data.role == 'learner') &&
        request.resource.data.status == 'active' &&
        request.resource.data.keys().hasOnly(['uid', 'name', 'phone', 'email', 'role', 'status', 'createdAt', 'referralCode', 'referredBy'])
      );
      allow update: if (isOwner(userId) || isAdmin()) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'uid', 'phone', 'status', 'createdAt']);
      allow delete: if isAdmin();
      match /purchases/{purchaseId} { allow read: if isOwner(userId) || isAdmin(); allow write: if isAdmin(); }
      match /access/{docId} { 
        allow read: if isOwner(userId) || isAdmin(); 
        allow write: if isAdmin(); 
      }
      match /progress/{progressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      match /examAttempts/{attemptId} { 
        allow read, write: if isOwner(userId) || isAdmin(); 
      }
      match /examResults/{resultId} { 
        allow read, write: if isOwner(userId) || isAdmin(); 
      }
      match /pointsLedger/{ledgerId} { 
        allow read, write: if isOwner(userId) || isAdmin(); 
      }
    }

    match /referralRewards/{rewardId} { allow read: if isSignedIn() && (resource.data.referrerId == request.auth.uid || isAdmin()); allow write: if false; }

    match /admins/{uid} { allow read: if isSignedIn() && (request.auth.uid == uid || isAdmin()); allow write: if false; }
    match /plans/{planId} { allow read: if resource.data.isActive == true || isAdmin(); allow write: if isAdmin(); }
    match /promotions/{promoId} { allow read: if true; allow write: if isAdmin(); }
    match /subscriptions/{subId} { allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow create, update, delete: if isAdmin(); }
    match /payments/{paymentId} { allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; }
    match /lessons/{lessonId} {
      allow read: if true; allow write: if isAdmin();
    }
    match /videos/{videoId} { allow read: if true; allow write: if isAdmin(); }
    match /categories/{categoryId} { allow read: if true; allow write: if isAdmin(); }
    match /questions/{questionId} { allow read: if isAdmin(); allow write: if isAdmin(); }
    match /examSettings/{settingId} { allow read: if true; allow write: if isAdmin(); }
    match /siteStats/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /siteSettings/{docId} { allow read: if true; allow write: if isAdmin(); }
    match /homepageSections/{secId} { allow read: if true; allow write: if isAdmin(); }
    match /homepageItems/{itemId} { allow read: if true; allow write: if isAdmin(); }
    match /announcements/{annId} { allow read: if true; allow write: if isAdmin(); }
    match /footerGroups/{groupId} { allow read: if true; allow write: if isAdmin(); }
    match /footerLinks/{linkId} { allow read: if true; allow write: if isAdmin(); }
    match /socialLinks/{socId} { allow read: if true; allow write: if isAdmin(); }
    match /siteMedia/{mediaId} { allow read: if true; allow write: if isAdmin(); }
    match /imageSlots/{slotId} { allow read: if true; allow write: if isAdmin(); }
    match /adminLogs/{logId} { allow read, write: if isAdmin(); }
    match /examResults/{resultId} { allow read: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()); allow write: if false; }
    match /{document=**} { allow read, write: if false; }
  }
}
